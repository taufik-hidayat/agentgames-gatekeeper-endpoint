# Copy to .env (never commit .env — it holds the HMAC secret).
# The secret is issued ONCE when you register the agent on the
# Agent Games dashboard (Agent settings -> HMAC secret / Rotate Secret).
# It is a 32-byte secret; paste it exactly as shown (hex, base64, or raw).

# Required in production (enforces HMAC verification).
# If unset, the server runs in dev mode with verification DISABLED.
AGENT_GAMES_HMAC_SECRET=

# Port the server listens on (default 3000).
PORT=3000

# Where state.json (seen proofs + idempotency responses) is stored.
# Default: ./data
DATA_DIR=./data

# Optional on-chain lookup (see zkverify.mjs). Leave unset unless you have
# a lookup endpoint (e.g. a Subscan API key or an indexer URL) that can
# answer {"found": true/false} for a proof_tx. Use {tx} as placeholder.
# ZKVERIFY_LOOKUP_URL=
# ZKVERIFY_LOOKUP_TIMEOUT_MS=4000
# ZKVERIFY_STRICT=false
